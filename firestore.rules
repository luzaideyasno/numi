rules_version = '2';

// Reglas de seguridad de Numi.
// Personal: users/{uid} con role 'admin' (coordinación) o 'teacher' (profesor, con lista "access" de cursos).
// Niñas: students/{uid} con courseId. Cada niña solo guarda sus propios resultados.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isStaff() && profile().role == 'admin'; }
    function teaches(c) { return isStaff() && profile().role == 'teacher' && c in profile().access; }
    function canCourse(c) { return isAdmin() || teaches(c); }

    // Profesores y coordinación
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // La primera cuenta de coordinación se crea sola desde el panel, una única vez
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
        && !exists(/databases/$(db)/documents/config/setup) && existsAfter(/databases/$(db)/documents/config/setup));
      // El profesor solo puede marcar que ya cambió su clave temporal
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']) && request.resource.data.mustChange == false);
      allow delete: if isAdmin();
    }

    // Marca de que la configuración inicial ya se hizo
    match /config/setup {
      allow get: if true;
      allow create: if signedIn() && !exists(/databases/$(db)/documents/config/setup)
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Cursos por año lectivo: solo la coordinación los crea o edita
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Escala de notas de cada curso: la cambia su profesor o la coordinación
    match /settings/{courseId} {
      allow read: if signedIn();
      allow write: if canCourse(courseId);
    }

    // Niñas: las crea el profesor del curso (desde la foto de la lista) o la coordinación
    match /students/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canCourse(resource.data.courseId));
      allow list: if canCourse(resource.data.courseId);
      allow create: if canCourse(request.resource.data.courseId);
      // La niña solo puede cambiar su armario y su resumen de retos (st)
      allow update: if canCourse(resource.data.courseId)
        || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wardrobe', 'st']));
      allow delete: if canCourse(resource.data.courseId);
    }

    // Resultado de cada reto: lo guarda la niña; lo leen ella, su profesor y la coordinación
    match /results/{id} {
      allow read: if canCourse(resource.data.courseId) || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && get(/databases/$(db)/documents/students/$(request.auth.uid)).data.courseId == request.resource.data.courseId;
      allow update: if isAdmin();
      // El profesor del curso puede borrarlos cuando elimina a una estudiante que se retiró
      allow delete: if isAdmin() || canCourse(resource.data.courseId);
    }

    // Notas ajustadas a mano y observaciones del profesor (una por niña)
    match /notes/{studentUid} {
      allow read: if canCourse(resource.data.courseId);
      allow create: if canCourse(request.resource.data.courseId);
      allow update: if canCourse(resource.data.courseId) && canCourse(request.resource.data.courseId);
      allow delete: if canCourse(resource.data.courseId);
    }

    // Tareas asignadas por el profesor
    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if canCourse(request.resource.data.courseId);
      allow update, delete: if canCourse(resource.data.courseId);
    }
  }
}
